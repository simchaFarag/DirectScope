# ---- שרת ----
NODE_ENV=development
PORT=4000
# כתובת ציבורית של ה-API (משמשת לבניית קישורים לקבצים שהועלו)
PUBLIC_URL=http://localhost:4000
# דומיינים שמורשים לקרוא ל-API (מופרדים בפסיק)
CORS_ORIGINS=http://localhost:5173
# 1 כשהשרת יושב מאחורי nginx (בפרודקשן)
TRUST_PROXY=0

# ---- מסד נתונים (MySQL / MariaDB) ----
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://directscope:directscope@localhost:3306/directscope

# ---- אימות ----
# מחרוזת אקראית ארוכה (לפחות 32 תווים). ליצירה: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=30d

# ---- SMS (קוד אימות) ----
# console = הקוד מודפס ללוג (פיתוח) | twilio = שליחה אמיתית
SMS_PROVIDER=console
# בפיתוח בלבד: קוד קבוע שתמיד עובד (להשאיר ריק בפרודקשן)
OTP_DEV_CODE=123456
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- קבצים ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
